[Desktop Entry]
{{!-- The same template serves the .deb and the AppImage, because Tauri builds the AppImage
     from the deb layout. It sets the freedesktop categories that Tauri's own template cannot:
     `bundle.category` maps to a single freedesktop category, and the app is both. --}}
Categories=Office;AudioVideo;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
